{
  "manifest_version": 3,
  "name": "Gemini Web to Local Bridge",
  "version": "2.0.0",
  "description": "Bridge Google Gemini Web chat and tool calls to local development tools.",
  "permissions": ["activeTab", "storage", "cookies", "alarms"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["network_interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": [
        "markdown_serializer.js",
        "status_hud.js",
        "gemini_controller.js",
        "gemini_extractor.js",
        "content.js"
      ],
      "css": ["status_hud.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Gemini Web to Local Bridge"
  }
}
